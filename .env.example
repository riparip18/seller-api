# Environment overrides for Seller API
# Copy this file to .env and fill in your values for local development.

# Staging (default)
VC_BASE_URL=https://apis.vcg.my.id
VC_ACCESS_KEY=your_staging_access_key
VC_SECRET_KEY=your_staging_secret_key

# Production (uncomment to use prod)
# VC_BASE_URL=https://apis.vcgamers.com
# VC_ACCESS_KEY=your_prod_access_key
# VC_SECRET_KEY=your_prod_secret_key

# Optional: reserved ngrok domain
# NGROK_STATIC_DOMAIN=your-domain.ngrok-free.app
